# ============================================
# Microsoft Graph API Configuration
# Required for Outlook email integration
# ============================================
AZURE_CLIENT_ID=your_azure_application_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_TENANT_ID=your_azure_tenant_id
OUTLOOK_EMAIL=your_email@example.com
OUTLOOK_FOLDER_ID=inbox

# ============================================
# Google Gemini API Keys
# Multiple keys enable automatic rotation to maximize free tier
# Add as many keys as needed: GOOGLE_API_KEY_1, GOOGLE_API_KEY_2, etc.
# ============================================
GOOGLE_API_KEY_1=your_first_gemini_api_key
GOOGLE_API_KEY_2=your_second_gemini_api_key
GOOGLE_API_KEY_3=your_third_gemini_api_key

# ============================================
# Google Custom Search API (Optional)
# Required only for hotel discovery feature
# ============================================
GOOGLE_SEARCH_API_KEY=your_google_search_api_key
GOOGLE_SEARCH_CX=your_custom_search_engine_id

# ============================================
# OpenAI API (Optional)
# Alternative LLM provider - not currently used
# ============================================
OPENAI_API_KEY=your_openai_api_key

# ============================================
# Airtable Configuration (Optional)
# Cloud database sync - system works without it
# ============================================
AIRTABLE_API_KEY=your_airtable_api_key
AIRTABLE_BASE_ID=your_airtable_base_id
AIRTABLE_TABLE_NAME=rates

# ============================================
# Database Configuration
# ============================================
DB_PATH=data/rates.db

# ============================================
# OCR Configuration
# ============================================
# Windows default path
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# macOS (if installed via Homebrew)
# TESSERACT_PATH=/usr/local/bin/tesseract

# Linux
# TESSERACT_PATH=/usr/bin/tesseract

# ============================================
# Notification Settings
# ============================================
NOTIFICATION_EMAIL=alerts@example.com
ENABLE_NOTIFICATIONS=true

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ============================================
# File Storage Settings
# ============================================
MAX_FILE_SIZE_MB=50
FILE_RETENTION_DAYS=30
ATTACHMENTS_DIR=./data/attachments
ARCHIVE_DIR=./data/archive
