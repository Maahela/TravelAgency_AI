# Microsoft Graph API Credentials
AZURE_CLIENT_ID=your_client_id_here
AZURE_CLIENT_SECRET=your_client_secret_here
AZURE_TENANT_ID=your_tenant_id_here

# Email Configuration
OUTLOOK_EMAIL=your_email@domain.com
OUTLOOK_FOLDER_ID=inbox  # or specific folder ID

# LLM API Configuration
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4  # or gpt-3.5-turbo

# OCR Configuration
TESSERACT_PATH=/usr/bin/tesseract  # Update based on your system

# Database Configuration
DB_PATH=./data/rates.db
# AIRTABLE_API_KEY=your_airtable_key  # If using Airtable
# AIRTABLE_BASE_ID=your_base_id
# AIRTABLE_TABLE_NAME=rates

# File Storage
ATTACHMENTS_DIR=./data/attachments

# Notification Settings
NOTIFICATION_EMAIL=admin@youragency.com
ENABLE_NOTIFICATIONS=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
