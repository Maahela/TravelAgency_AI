# Copy this file to .env and fill in real values. Never commit .env.

# Microsoft Graph API (Azure app registration)
AZURE_CLIENT_ID=your_azure_app_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_TENANT_ID=your_azure_tenant_id
# Where the MSAL token cache is stored (contains refresh tokens: keep it private)
TOKEN_CACHE_PATH=.token_cache.bin

# Email Configuration
OUTLOOK_EMAIL=your_email@domain.com
OUTLOOK_FOLDER_ID=inbox  # or specific folder ID

# Sender details used in outgoing email templates
AGENCY_NAME=Your Travel Agency
SENDER_NAME=Your Name
SENDER_PHONE=
SENDER_EMAIL=reservations@example.com

# LLM API Configuration
# Google API Keys (supports quota rotation - add as many as needed)
GOOGLE_API_KEY_1=your_first_google_api_key
GOOGLE_API_KEY_2=your_second_google_api_key
# Add more keys: GOOGLE_API_KEY_3, GOOGLE_API_KEY_4, etc.

# Google Custom Search (hotel email discovery)
GOOGLE_SEARCH_API_KEY=your_google_search_api_key
GOOGLE_SEARCH_CX=your_search_engine_id

# OpenAI (fallback - not fully implemented)
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4  # or gpt-3.5-turbo

# OCR Configuration
TESSERACT_PATH=/usr/bin/tesseract  # Update based on your system

# Database Configuration
DB_PATH=./data/rates.db
AIRTABLE_API_KEY=your_airtable_personal_access_token
AIRTABLE_BASE_ID=your_airtable_base_id
AIRTABLE_TABLE_NAME=rates

# Admin dashboard API
# Shared secret required in the X-API-Key header. Leave empty only for localhost use.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
# Browser origins allowed to call the API (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_HOST=127.0.0.1
API_PORT=4005

# File Storage
ATTACHMENTS_DIR=./data/attachments
ARCHIVE_DIR=./data/archive
MAX_FILE_SIZE_MB=50  # Maximum file size in MB
FILE_RETENTION_DAYS=30  # Days to keep files before archiving

# Notification Settings
NOTIFICATION_EMAIL=admin@example.com
ENABLE_NOTIFICATIONS=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
